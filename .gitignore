# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
# .import/ 文件必须提交到 git，包含资源导入配置
export.cfg
export_credentials.cfg
*.remap

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# AI-coding ignores
tmp*.*
.claude/*
!/.claude/skills/
!/.claude/skills/**
!/.claude/agents/
!/.claude/agents/**
.kilocode/
.mcp.json
QWEN.md
.clef-work/
.zcode/

# 根目录遗留 skills（已由 addons/fuse/agent_skills/ 统一收纳取代，2026-09-01）
/skills/

# 开发期一次性存档（图标挑选器网页快照等）
/@icons picker.html

# Backup and temporary directories
backups/
recordings/
*.backup
*.bak
*.old

# Third party resources (默认不提交第三方资源)
# 例外：Pixel Adventure 1 — demo 需要的美术资源
third_party_resources/*
!third_party_resources/Pixel Adventure 1/

# Test output files
test_*.log
test_*.txt

# Fuse topology problem reports (auto-generated)
fuse_reports/

# Fuse 毕业导出器 System 草稿（自动生成；定稿金样例才入库）
fuse_generated/systems/drafts/

# Graphify - local state (machine-specific, not meaningful to share)
# 知识图谱是 graphify 生成物（单份 graph.json 约 28MB，仓库曾跟踪 4 份共约 106MB），
# fresh clone 后跑 `graphify update .` 即可重建；整目录不入库
/graphify-out/

# Python cache and tool output
__pycache__/
.ruff_cache/
*.pyc
*.pyo
tools/check_results.txt

# Brainstorm session artifacts
.superpowers/brainstorm/

# Test tooling caches
.playwright/
.pytest_cache/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Editor workspace (machine-specific paths)
.vscode/

# Auto-generated evaluation reports
docs/reports/event_migration_evaluation_*.md
music21/

# Top-level dev content (local reference / dev-only, not published with plugin)
# Note: leading slash anchors to repo root — addons/fuse/* is NOT affected.
/docs/
/scripts/
/plans/
/test_scripts/
/tools/

# Local-only dev plugins (本地开发依赖，不提交远程)
# 方案 Y 约束：Fuse 发布零 ast-flow 痕迹。gdscript_ast 仅开发期 codegen 用。
addons/gdscript_ast/
addons/AutoKey_SpriteFrames/

# 本地图标素材（仅开发期用，不提交）
addons/at-icons/

# Archived fuse docs (historical, kept locally, not published with plugin)
/addons/fuse/docs/archive/
# AI 生成工作区不进 git；例外：evals/（seed case + baseline 是版本化的评测语料）
fuse-preset-generator-workspace/*
!fuse-preset-generator-workspace/evals/
!fuse-preset-generator-workspace/eval_baseline.json
!fuse-preset-generator-workspace/iteration-1/
# iteration-1 产物不进 git；例外：report.json/md（回归门禁证据入库）
# + case/{with,without}_skill/outputs/*.json 共 6 份产物 JSON（2026-08-21 终审 C1：
#   committed 测试断言与 eval_baseline.json 引用的版本化评测语料，fresh clone 回归必须可跑，
#   对齐 evals/baseline/report 入库先例；逐层放行目录是因为 git 不深入被排除的目录）
fuse-preset-generator-workspace/iteration-1/*
!fuse-preset-generator-workspace/iteration-1/report.json
!fuse-preset-generator-workspace/iteration-1/report.md
!fuse-preset-generator-workspace/iteration-1/*/
fuse-preset-generator-workspace/iteration-1/*/*
!fuse-preset-generator-workspace/iteration-1/*/*_skill/
fuse-preset-generator-workspace/iteration-1/*/*/*
!fuse-preset-generator-workspace/iteration-1/*/*/outputs/
fuse-preset-generator-workspace/iteration-1/*/*/*/*
!fuse-preset-generator-workspace/iteration-1/*/*/outputs/*.json
# iteration-2 产物不进 git；例外：report.json/md + handcrafted 样例副本（L3/L4 门禁证据入库）
!fuse-preset-generator-workspace/iteration-2/
fuse-preset-generator-workspace/iteration-2/*
!fuse-preset-generator-workspace/iteration-2/report.json
!fuse-preset-generator-workspace/iteration-2/report.md
!fuse-preset-generator-workspace/iteration-2/handcrafted/
fuse-preset-generator-workspace/iteration-2/handcrafted/*
!fuse-preset-generator-workspace/iteration-2/handcrafted/outputs/
fuse-preset-generator-workspace/iteration-2/handcrafted/outputs/*
!fuse-preset-generator-workspace/iteration-2/handcrafted/outputs/sample_l3_runner.json
!fuse-preset-generator-workspace/iteration-2/handcrafted/outputs/sample_l4_multi.json

# 测试运行期生成的迷你 fixture workspace（test_eval_runner 自建自清）
addons/fuse/tests/preset_ai/fixtures/
