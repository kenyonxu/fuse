# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
# .import/ 文件必须提交到 git，包含资源导入配置
export.cfg
export_credentials.cfg
*.remap

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# AI-coding ignores
tmp*.*
.claude/*
!/.claude/skills/
!/.claude/skills/**
!/.claude/agents/
!/.claude/agents/**
.kilocode/
.mcp.json
QWEN.md
.clef-work/

# Backup and temporary directories
backups/
recordings/
*.backup
*.bak
*.old

# Third party resources (默认不提交第三方资源)
# 例外：Pixel Adventure 1 — demo 需要的美术资源
third_party_resources/*
!third_party_resources/Pixel Adventure 1/

# Test output files
test_*.log
test_*.txt

# Fuse topology problem reports (auto-generated)
fuse_reports/

# Graphify - local state (machine-specific, not meaningful to share)
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/cost.json
graphify-out/manifest.json

# Python cache and tool output
__pycache__/
*.pyc
*.pyo
tools/check_results.txt

# Brainstorm session artifacts
.superpowers/brainstorm/

# Test tooling caches
.playwright/
.pytest_cache/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Editor workspace (machine-specific paths)
.vscode/

# Auto-generated evaluation reports
docs/reports/event_migration_evaluation_*.md
music21/

# Top-level dev content (local reference / dev-only, not published with plugin)
# Note: leading slash anchors to repo root — addons/fuse/* is NOT affected.
/docs/
/scripts/
/plans/
/test_scripts/
/tools/

# Local-only dev plugins (本地开发依赖，不提交远程)
# 方案 Y 约束：Fuse 发布零 ast-flow 痕迹。gdscript_ast 仅开发期 codegen 用。
addons/gdscript_ast/
addons/AutoKey_SpriteFrames/

# 本地图标素材（仅开发期用，不提交）
addons/at-icons/

# Archived fuse docs (historical, kept locally, not published with plugin)
/addons/fuse/docs/archive/
fuse-preset-generator-workspace/
