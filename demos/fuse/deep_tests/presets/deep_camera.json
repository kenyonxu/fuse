{
  "format_version": "2.0",
  "level": "L4",
  "display_name": "DeepCamera",
  "category": "camera",
  "description": "深度测试·Camera：7 指令（v4：跟随链与效果链分绑定）",
  "icon_name": "",
  "variables": {
    "local": [
      "cam_pos",
      "cam_pos2",
      "cexp",
      "cexp2"
    ],
    "scope": [],
    "global": []
  },
  "trigger_config": {
    "use_parallel_condition_evaluation": false
  },
  "event_bindings": [
    {
      "event": {
        "type": "OnReady"
      },
      "binding_config": {
        "enabled": true,
        "trigger_once": true,
        "cooldown_mode": 0,
        "cooldown_time": 1.0
      },
      "action_runner": {
        "execution_mode": 0,
        "instructions": [
          {
            "type": "Print",
            "message": "=== deep_camera START（2 秒后开始，请盯住游戏窗口）==="
          },
          {
            "type": "Wait",
            "wait_time": 2.0
          },
          {
            "type": "Print",
            "message": ">>> [F5] 阶段1/5：变焦 zoom=2.0 —— 画面放大一倍"
          },
          {
            "type": "SetCameraZoom",
            "target_node": "../Cam",
            "zoom": 2.0,
            "zoom_mode": 0
          },
          {
            "type": "IfElse",
            "sequence_mode": 0,
            "condition": {
              "type": "CheckNodeProperty",
              "target_node_path": "../Cam",
              "property_name": "zoom",
              "property_value": "(2.0, 2.0)"
            },
            "true_instructions": [
              {
                "type": "Print",
                "message": "PASS: SetCameraZoom"
              }
            ],
            "false_instructions": [
              {
                "type": "Print",
                "message": "FAIL: SetCameraZoom"
              }
            ]
          },
          {
            "type": "Wait",
            "wait_time": 2.5
          },
          {
            "type": "Print",
            "message": ">>> [F5] 阶段2/5：相机锁定跟随 Player(0,0) —— 画面瞬移到左下角"
          },
          {
            "type": "SetPosition",
            "target_node": "../Player",
            "position": "(0.0, 0.0, 0.0)"
          },
          {
            "type": "CameraFollow",
            "target_node": "../Player",
            "camera_node": "../Cam",
            "follow_mode": 0
          },
          {
            "type": "Wait",
            "wait_time": 0.3
          },
          {
            "type": "GetPosition",
            "target": "../Cam",
            "save_to_variable": "cam_pos"
          },
          {
            "type": "MathExpression",
            "expression": "Vector2(0, 0)",
            "output_type": 2,
            "save_to_variable": "cexp"
          },
          {
            "type": "IfElse",
            "sequence_mode": 0,
            "condition": {
              "type": "CheckVariable",
              "variable_name": "cam_pos",
              "check_with_another_variable": true,
              "compare_variable": "cexp",
              "comparison_operator": 0,
              "auto_convert_types": true
            },
            "true_instructions": [
              {
                "type": "Print",
                "message": "PASS: CameraFollow(锁定0,0)"
              }
            ],
            "false_instructions": [
              {
                "type": "Print",
                "message": "FAIL: CameraFollow(锁定0,0)"
              }
            ]
          },
          {
            "type": "Wait",
            "wait_time": 2.0
          },
          {
            "type": "Print",
            "message": ">>> [F5] 阶段3/5：Player→(600,0) 相机跟跳；随后设右边界 400、Player 冲 900 —— 画面卡在边界"
          },
          {
            "type": "SetPosition",
            "target_node": "../Player",
            "position": "(600.0, 0.0, 0.0)"
          },
          {
            "type": "Wait",
            "wait_time": 0.5
          },
          {
            "type": "GetPosition",
            "target": "../Cam",
            "save_to_variable": "cam_pos2"
          },
          {
            "type": "MathExpression",
            "expression": "Vector2(600, 0)",
            "output_type": 2,
            "save_to_variable": "cexp2"
          },
          {
            "type": "IfElse",
            "sequence_mode": 0,
            "condition": {
              "type": "CheckVariable",
              "variable_name": "cam_pos2",
              "check_with_another_variable": true,
              "compare_variable": "cexp2",
              "comparison_operator": 0,
              "auto_convert_types": true
            },
            "true_instructions": [
              {
                "type": "Print",
                "message": "PASS: CameraFollow(跟随600)"
              }
            ],
            "false_instructions": [
              {
                "type": "Print",
                "message": "FAIL: CameraFollow(跟随600)"
              }
            ]
          },
          {
            "type": "Wait",
            "wait_time": 1.5
          },
          {
            "type": "SetCameraLimit",
            "target_node": "../Cam",
            "limit_side": 2,
            "limit_value": -100
          },
          {
            "type": "IfElse",
            "sequence_mode": 0,
            "condition": {
              "type": "CheckNodeProperty",
              "target_node_path": "../Cam",
              "property_name": "limit_left",
              "property_value": -100
            },
            "true_instructions": [
              {
                "type": "Print",
                "message": "PASS: SetCameraLimit(Left)"
              }
            ],
            "false_instructions": [
              {
                "type": "Print",
                "message": "FAIL: SetCameraLimit(Left)"
              }
            ]
          },
          {
            "type": "SetCameraLimit",
            "target_node": "../Cam",
            "limit_side": 3,
            "limit_value": 400
          },
          {
            "type": "IfElse",
            "sequence_mode": 0,
            "condition": {
              "type": "CheckNodeProperty",
              "target_node_path": "../Cam",
              "property_name": "limit_right",
              "property_value": 400
            },
            "true_instructions": [
              {
                "type": "Print",
                "message": "PASS: SetCameraLimit(Right)"
              }
            ],
            "false_instructions": [
              {
                "type": "Print",
                "message": "FAIL: SetCameraLimit(Right)"
              }
            ]
          },
          {
            "type": "SetPosition",
            "target_node": "../Player",
            "position": "(900.0, 0.0, 0.0)"
          },
          {
            "type": "Wait",
            "wait_time": 2.5
          },
          {
            "type": "Print",
            "message": ">>> [F5] 阶段4/5：Area2D 边界（0..200 盒子）—— 画面被拉回中央小区"
          },
          {
            "type": "SetCameraLimitFromArea2D",
            "camera_node": "../Cam",
            "bounds_area": "../Bounds"
          },
          {
            "type": "IfElse",
            "sequence_mode": 0,
            "condition": {
              "type": "CheckNodeProperty",
              "target_node_path": "../Cam",
              "property_name": "limit_left",
              "property_value": 0
            },
            "true_instructions": [
              {
                "type": "Print",
                "message": "PASS: SetCameraLimitFromArea2D(left)"
              }
            ],
            "false_instructions": [
              {
                "type": "Print",
                "message": "FAIL: SetCameraLimitFromArea2D(left)"
              }
            ]
          },
          {
            "type": "Wait",
            "wait_time": 2.5
          },
          {
            "type": "Print",
            "message": ">>> [F5] 阶段5/5：Player 静止回中央，随后另一链执行震动与淡出"
          },
          {
            "type": "SetPosition",
            "target_node": "../Player",
            "position": "(100.0, 50.0, 0.0)"
          },
          {
            "type": "Wait",
            "wait_time": 1.0
          },
          {
            "type": "Print",
            "message": "=== 绑定1 DONE（跟随与边界）==="
          }
        ]
      }
    },
    {
      "event": {
        "type": "OnReady"
      },
      "binding_config": {
        "enabled": true,
        "trigger_once": true,
        "cooldown_mode": 0,
        "cooldown_time": 1.0
      },
      "action_runner": {
        "execution_mode": 0,
        "instructions": [
          {
            "type": "Wait",
            "wait_time": 16.0
          },
          {
            "type": "Print",
            "message": ">>> [F5] 附加A：相机震动 1.0s"
          },
          {
            "type": "CameraShake",
            "target_node": "../Cam",
            "intensity": 0.3,
            "duration": 1.0
          },
          {
            "type": "Print",
            "message": "PASS(m): CameraShake(F5 观感)"
          },
          {
            "type": "Wait",
            "wait_time": 2.0
          },
          {
            "type": "Print",
            "message": ">>> [F5] 附加B：淡出→淡入"
          },
          {
            "type": "CameraFadeOut",
            "color": "(0, 0, 0, 1)",
            "duration": 0.6
          },
          {
            "type": "Wait",
            "wait_time": 0.9
          },
          {
            "type": "CameraFadeIn",
            "color": "(0, 0, 0, 1)",
            "duration": 0.6
          },
          {
            "type": "Wait",
            "wait_time": 0.9
          },
          {
            "type": "Print",
            "message": "PASS(m): CameraFadeOut+CameraFadeIn(F5 观感)"
          },
          {
            "type": "Print",
            "message": ">>> [F5] 终态复位：zoom=1.0"
          },
          {
            "type": "SetCameraZoom",
            "target_node": "../Cam",
            "zoom": 1.0,
            "zoom_mode": 0
          },
          {
            "type": "Print",
            "message": "=== deep_camera DONE ==="
          }
        ]
      }
    }
  ]
}
