[ext_resource type="Script" path="res://addons/juicy_mixer/resources/music/music_state_map.gd" id="1"]

[resource]
script = ExtResource("1")
state_map = {
&"menu": null,
&"exploring": null,
&"combat": null,
&"boss": null,
&"event": null
}

# 使用说明：
#
# 1. 创建 5 个 MusicTrackResource 资源文件：
#    - menu_track.tres (菜单音乐)
#    - exploring_track.tres (探索音乐)
#    - combat_track.tres (战斗音乐)
#    - boss_track.tres (Boss战音乐)
#    - event_track.tres (特殊事件音乐)
#
# 2. 在每个 MusicTrackResource 中配置：
#    - loop_stream: 拖入对应的音频文件 (.ogg/.mp3/.wav)
#    - music_type: 选择 STANDARD (标准循环)
#    - 确保 loop 属性在导入时已勾选
#
# 3. 在本资源文件中，将上面的 null 替换为对应的资源：
#    state_map = {
#    &"menu": preload("res://music/menu_track.tres"),
#    &"exploring": preload("res://music/exploring_track.tres"),
#    &"combat": preload("res://music/combat_track.tres"),
#    &"boss": preload("res://music/boss_track.tres"),
#    &"event": preload("res://music/event_track.tres")
#    }
#
# 4. 保存文件
#
# 快速测试步骤：
# 1. 在编辑器中打开 test_music_player_ui.tscn
# 2. 运行场景
# 3. 点击"加载测试状态映射"按钮
# 4. 使用各个按钮测试压入/弹出功能
# 5. 观察调试信息面板的堆栈状态
