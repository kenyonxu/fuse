[gd_resource type="Resource" script_class="MusicPriorityConfig" load_steps=2 format=3 uid="uid://e8f9g0h1i2j3"]

[ext_resource type="Script" path="res://addons/juicy_mixer/resources/music/music_priority_config.gd" id="1"]

[resource]
script = ExtResource("1")

# 示例优先级配置
# 定义可自定义的优先级列表
# 数值越高，优先级越高

priorities = [SubResource("Resource_1"), SubResource("Resource_2"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5")]

[resource]
script = null
name = &"global"
value = 0
description = "全局/默认音乐（菜单、标题）"

[resource]
script = null
name = &"exploring"
value = 1
description = "探索音乐"

[resource]
script = null
name = &"combat"
value = 2
description = "战斗音乐"

[resource]
script = null
name = &"boss"
value = 3
description = "Boss战音乐"

[resource]
script = null
name = &"event"
value = 4
description = "特殊事件/临时音乐"

# 使用说明：
#
# 1. 在 MusicPlayer 中引用此资源：
#    MusicPlayer → Inspector → Priority Config → 拖入此资源
#
# 2. 使用 push_state_by_name() 按优先级名称压入状态：
#    music_player.push_state_by_name(&"combat", &"combat")
#
# 3. 自定义优先级：
#    - 修改此资源中的优先级数值
#    - 添加新的优先级条目
#    - 删除不需要的优先级
#    - 调整优先级顺序
#
# 4. 创建分层优先级（适用于复杂游戏）：
#    priorities = [
#      {name = &"ambient", value = 0, description = "环境音"},
#      {name = &"exploration", value = 10, description = "基础探索"},
#      {name = &"secondary", value = 20, description = "次要音乐层"},
#      {name = &"primary", value = 30, description = "主要音乐"},
#      {name = &"focus", value = 40, description = "焦点事件"},
#      {name = &"critical", value = 50, description = "关键事件"}
#    ]
